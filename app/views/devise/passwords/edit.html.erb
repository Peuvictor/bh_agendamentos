<div class="account-form max-w-md mx-auto rounded-2xl border border-gray-100 bg-white p-4 sm:p-8 shadow-sm">
  <h2 class="text-2xl font-bold text-blue-900 mb-6">Redefinir senha</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="field mb-4">
      <p><%= f.label :password, "Nova senha" %></p>
      <p><%= f.password_field :password, minlength: resource.class.password_length.min, maxlength: resource.class.password_length.max, aria: { describedby: "password-requirements" }, required: true, autofocus: true, autocomplete: "new-password" %></p>
      <%= render "devise/shared/password_requirements", resource: resource %>
    </div>

    <div class="field mb-4">
      <p><%= f.label :password_confirmation, "Confirmar nova senha" %></p>
      <p><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></p>
    </div>

    <div class="actions mt-6 mb-4">
      <%= f.submit "Salvar nova senha" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
