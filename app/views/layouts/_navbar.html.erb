<nav class="site-navigation bg-white border-b border-gray-200 sticky top-0 z-50" aria-label="Navegação principal"
     data-controller="navigation" data-action="keydown.esc->navigation#close">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="navigation-header">
      <%= link_to root_path, class: "site-brand flex items-center gap-2 text-base sm:text-xl font-bold tracking-tight text-gray-900", aria: { label: "BH Agendamentos — início" } do %>
        <span class="rounded-xl bg-blue-600 p-2 text-white" aria-hidden="true">
          <svg class="w-6 h-6" viewBox="0 0 100 100" fill="currentColor">
            <path d="M10 40L30 20L50 35L70 15L90 30V80C90 85.5 85.5 90 80 90H20C14.5 90 10 85.5 10 80V40ZM25 75V65H35V75H25ZM25 55V45H35V55H25ZM45 75V65H55V75H45ZM45 55V45H55V55H45ZM65 75V65H75V75H65ZM65 55V45H75V55H65Z"/>
          </svg>
        </span>
        <span class="flex flex-col">
          <span>BH <span class="text-blue-600">Agendamentos</span></span>
          <span class="text-[10px] uppercase tracking-widest text-gray-400 font-semibold italic">Minas Technology</span>
        </span>
      <% end %>
      <button type="button" class="navigation-toggle rounded-lg border border-gray-200 px-3 font-bold text-blue-900"
              aria-expanded="false" aria-controls="navigation-links" hidden
              data-navigation-target="toggle" data-action="navigation#toggle">Menu</button>
    </div>
    <div id="navigation-links" class="navigation-links" data-navigation-target="links">
      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to "👑 MODO DEUS", admin_root_path, class: "rounded-lg bg-purple-700 text-white font-bold px-3" %>
        <% end %>
        <%= link_to "📅 Agendamentos", appointments_path, class: "font-bold text-blue-900",
                    aria: { current: (current_page?(appointments_path) || current_page?(authenticated_root_path)) ? "page" : nil } %>
        <% if current_user.provider? %>
          <%= link_to "📊 Dashboard", dashboard_path, class: "font-bold text-gray-800" %>
          <%= link_to "✂️ Serviços", services_path, class: "font-bold text-blue-900" %>
          <%= link_to "📆 Calendário", provider_calendar_path, class: "font-bold text-blue-900" %>
          <%= link_to "🕒 Disponibilidade", provider_availability_path, class: "font-bold text-blue-900" %>
        <% end %>
        <%= link_to "Configurações", edit_user_registration_path, class: "font-semibold text-gray-600" %>
        <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "font-semibold text-red-600" %>
      <% else %>
        <%= link_to "Entrar", new_user_session_path, class: "font-semibold text-gray-700" %>
        <%= link_to "Criar Conta", new_user_registration_path, class: "rounded-full bg-blue-600 px-5 font-bold text-white" %>
      <% end %>
    </div>
  </div>
</nav>
