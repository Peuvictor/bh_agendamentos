<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-gray-50">
  <head>
    <title>BH Agendamentos</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mp-public-key" content="<%= ENV.fetch("MERCADO_PAGO_PUBLIC_KEY", "") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://sdk.mercadopago.com/js/v2" data-turbo-track="reload"></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
  </head>

  <body class="h-full text-gray-900 antialiased">
    <%= render "layouts/navbar" %>

    <main class="max-w-7xl mx-auto px-4 py-6 sm:py-10">
      <%# Flash Messages %>
      <% if notice %>
        <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl text-sm font-medium"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-6 bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 rounded-xl text-sm font-medium"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
