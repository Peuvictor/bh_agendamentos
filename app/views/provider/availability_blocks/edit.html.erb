<section class="max-w-2xl mx-auto rounded-2xl border border-gray-100 bg-white p-4 sm:p-6 shadow-sm">
  <h1 class="text-3xl font-extrabold text-blue-900 mb-6">Editar bloqueio</h1>
  <p class="mb-5 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
    O bloqueio impede novas reservas, mas não cancela agendamentos que já foram feitos.
  </p>

  <% if @block_form.errors.any? %>
    <div role="alert" class="mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
      <p class="font-bold">Não foi possível salvar o bloqueio:</p>
      <ul class="list-disc pl-5">
        <% @block_form.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: provider_availability_block_path(@block), scope: :availability_block, method: :patch, class: "space-y-6" do |form| %>
    <%= render "provider/availability_blocks/fields", form: form, services: @services,
               minimum_date: [Date.current, @block.starts_at_in_database.to_date].min,
               values: { date: @block_form.date, all_day: @block_form.all_day?,
                         start_time: @block_form.start_time, end_time: @block_form.end_time,
                         service_id: @block_form.service_id, reason: @block_form.reason } %>
    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit "Salvar alterações", class: "rounded-xl bg-blue-900 px-6 py-3 font-bold text-white cursor-pointer" %>
      <%= link_to "Cancelar", provider_availability_path, class: "touch-link font-bold text-gray-600 hover:text-gray-900" %>
    </div>
  <% end %>
</section>
