<div class="space-y-6"
     data-controller="provider-calendar"
     data-provider-calendar-events-url-value="<%= provider_calendar_events_path %>"
     data-provider-calendar-business-hours-value="<%= @business_hours.to_json %>">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-extrabold text-blue-900">Calendário</h1>
      <p class="mt-1 text-sm text-gray-500">Acompanhe agendamentos, bloqueios e horários de atendimento.</p>
    </div>

    <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-semibold text-gray-700">
      <input type="checkbox"
             data-provider-calendar-target="history"
             data-action="change->provider-calendar#toggleHistory"
             class="rounded border-gray-300 text-blue-700 focus:ring-blue-500">
      Exibir cancelados e reembolsados
    </label>
  </header>

  <section class="rounded-2xl border border-gray-100 bg-white p-3 shadow-sm sm:p-6">
    <div class="mb-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-gray-600" aria-label="Legenda do calendário">
      <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-emerald-600"></span>Confirmado</span>
      <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-amber-600"></span>Pendente</span>
      <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-slate-500"></span>Cancelado</span>
      <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-violet-700"></span>Reembolsado</span>
      <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-red-600"></span>Bloqueio</span>
    </div>

    <div data-provider-calendar-target="error"
         class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
         role="alert">
      Não foi possível carregar os eventos. Verifique sua conexão e tente novamente.
      <button type="button" data-action="provider-calendar#retry" class="ml-2 font-bold underline">Tentar novamente</button>
    </div>

    <div data-provider-calendar-target="calendar" aria-label="Calendário do prestador"></div>
  </section>

  <dialog data-provider-calendar-target="dialog"
          data-action="click->provider-calendar#closeOnBackdrop"
          class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl border-0 p-0 shadow-2xl backdrop:bg-slate-900/50">
    <div class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p data-provider-calendar-target="kind" class="text-xs font-bold uppercase tracking-wider text-blue-700"></p>
          <h2 data-provider-calendar-target="title" class="mt-1 text-xl font-extrabold text-gray-900"></h2>
        </div>
        <button type="button"
                data-action="provider-calendar#closeDialog"
                class="rounded-lg p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-700"
                aria-label="Fechar detalhes">✕</button>
      </div>

      <dl class="mt-6 space-y-3 text-sm">
        <div>
          <dt class="font-bold text-gray-500">Horário</dt>
          <dd data-provider-calendar-target="time" class="text-gray-900"></dd>
        </div>
        <div data-provider-calendar-target="clientRow">
          <dt class="font-bold text-gray-500">Cliente</dt>
          <dd data-provider-calendar-target="client" class="text-gray-900"></dd>
        </div>
        <div>
          <dt class="font-bold text-gray-500">Serviço</dt>
          <dd data-provider-calendar-target="service" class="text-gray-900"></dd>
        </div>
        <div data-provider-calendar-target="statusRow">
          <dt class="font-bold text-gray-500">Status</dt>
          <dd data-provider-calendar-target="status" class="capitalize text-gray-900"></dd>
        </div>
        <div data-provider-calendar-target="reasonRow">
          <dt class="font-bold text-gray-500">Motivo</dt>
          <dd data-provider-calendar-target="reason" class="text-gray-900"></dd>
        </div>
      </dl>

      <a data-provider-calendar-target="detailsLink"
         class="mt-6 inline-flex w-full justify-center rounded-xl bg-blue-900 px-5 py-3 text-sm font-bold text-white hover:bg-blue-800">
        Ver detalhes do agendamento
      </a>
    </div>
  </dialog>
</div>
