<div class="max-w-2xl mx-auto my-10 p-6 bg-white rounded-xl shadow-md border border-gray-100">
  <h1 class="text-2xl font-bold mb-6">Reagendar atendimento</h1>
  <p class="font-semibold"><%= @appointment.service.nome %></p>
  <p>Prestador: <%= @appointment.service.user.nome %></p>
  <p>Horário atual: <%= l(@appointment.start_time, format: :long) %></p>
  <p>Duração: <%= @appointment.reserved_duration&.to_i %> minutos</p>
  <p>Valor pago: <%= number_to_currency(@appointment.payment&.amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
  <p class="mt-3 text-sm text-gray-600">A duração e o pagamento serão mantidos. Cliente e prestador receberão um e-mail com a mudança.</p>

  <% if @rescheduling_error %>
    <p role="alert" class="my-4 p-4 rounded-lg bg-red-50 text-red-800"><%= @rescheduling_error %></p>
  <% end %>
  <% if @stale_schedule %>
    <%= link_to "Recarregar formulário", edit_appointment_path(@appointment), class: "block my-4 underline" %>
  <% end %>

  <%= form_with url: appointment_path(@appointment), method: :patch, class: "mt-6 space-y-5",
      data: { controller: "rescheduling-slots", rescheduling_slots_url_value: available_slots_appointment_path(@appointment) } do %>
    <%= hidden_field_tag :schedule_token, @schedule_token %>
    <div>
      <%= label_tag :appointment_date, "Nova data", class: "block font-medium" %>
      <%= date_field_tag :appointment_date, @selected_date, min: Date.current, required: true,
          class: "w-full rounded-lg border-gray-300",
          data: { rescheduling_slots_target: "date", action: "change->rescheduling-slots#refresh" } %>
    </div>
    <div>
      <%= label_tag :appointment_hour, "Novo horário", class: "block font-medium" %>
      <% options = @available_slots.map { |slot| [slot, slot] } %>
      <% if params[:appointment_hour].present? && !@available_slots.include?(params[:appointment_hour]) %>
        <% options.unshift(["#{params[:appointment_hour]} (indisponível)", params[:appointment_hour], { disabled: true }]) %>
      <% end %>
      <%= select_tag :appointment_hour, options_for_select(options, params[:appointment_hour]),
          prompt: @available_slots.any? ? "Selecione um horário" : "Nenhum horário disponível", required: true,
          class: "w-full rounded-lg border-gray-300", data: { rescheduling_slots_target: "hour" } %>
    </div>
    <p role="status" aria-live="polite" class="text-sm text-red-700" data-rescheduling-slots-target="feedback"></p>
    <%= submit_tag "Confirmar reagendamento", disabled: @stale_schedule,
        class: "w-full bg-blue-900 text-white font-bold py-3 px-6 rounded-xl disabled:opacity-50" %>
    <%= link_to "Voltar ao agendamento", appointment_path(@appointment), class: "block text-center underline" %>
  <% end %>
</div>
